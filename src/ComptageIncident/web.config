<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================================================
   web.config : configuration IIS (utilisé UNIQUEMENT en hébergement IIS ; ignoré en mode autonome)
  =====================================================================================================
   - Le module ASP.NET Core (AspNetCoreModuleV2, installé par le « Hosting Bundle ») charge l'application
     DANS le processus IIS (hostingModel="inprocess") : IIS effectue l'authentification Windows et transmet
     l'identité de l'utilisateur à l'application.
   - ASPNETCORE_ENVIRONMENT=Production : la configuration de développement (utilisateur simulé, annuaire
     fictif) n'est jamais chargée.
   - Voir docs/07-installation-iis.md.
  =====================================================================================================
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Toutes les requêtes (*) sont confiées à l'application ASP.NET Core. -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        processPath   : exécutable produit par « dotnet publish -r win-x64 ».
        stdoutLogEnabled : passer à "true" TEMPORAIREMENT pour diagnostiquer un échec de démarrage
                           (les journaux sont alors écrits dans .\logs\ ; le dossier doit exister).
      -->
      <aspNetCore processPath=".\ComptageIncident.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!--
        Authentification : Windows obligatoire, anonyme désactivé.
        L'application exige de toute façon un utilisateur authentifié (Program.cs) : si l'anonyme restait
        activé par erreur, les utilisateurs recevraient un refus (401), jamais un accès anonyme.

        Si IIS renvoie l'erreur 500.19 « This configuration section cannot be used at this path »,
        les sections sont verrouillées au niveau serveur. Déverrouillez-les une fois (administrateur) :
          %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/windowsAuthentication
          %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/anonymousAuthentication
        ou lancez deploy\Install-IIS.ps1 qui les déverrouille pour ce site uniquement.
      -->
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
        <!-- Limite la taille des requêtes à 1 Mo : l'API n'échange que de petits objets JSON. -->
        <requestFiltering>
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
      <!-- Ne pas révéler la technologie serveur dans les en-têtes de réponse. -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
