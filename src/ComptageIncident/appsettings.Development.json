// =====================================================================================================
//  appsettings.Development.json : configuration de DÉVELOPPEMENT uniquement
// =====================================================================================================
//  Chargé seulement si ASPNETCORE_ENVIRONMENT=Development, et JAMAIS copié lors d'une publication
//  (voir ComptageIncident.csproj). Il ne peut donc pas être actif sur un serveur de production.
// =====================================================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Annuaire fictif (Directory/FakeDirectoryService.cs) : permet de tester hors domaine Windows.
  "Directory": {
    "Provider": "Fake"
  },
  // Utilisateur simulé (Auth/DevAuthenticationHandler.cs) à la place de l'authentification Windows.
  "Auth": {
    "DevUser": "DEV\\testeur"
  },
  // Écoute uniquement en local sur le poste du développeur.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5112"
      }
    }
  }
}
