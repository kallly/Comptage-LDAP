// =====================================================================================================
//  appsettings.json : configuration de PRODUCTION de « Comptage incident »
// =====================================================================================================
//  - Les commentaires (// ...) sont acceptés par ASP.NET Core dans ce fichier.
//  - Toute modification nécessite un redémarrage de l'application (recyclage du pool IIS ou
//    redémarrage du service Windows).
//  - Les scripts de mise à jour (deploy\Install-*.ps1) CONSERVENT ce fichier s'il existe déjà sur le serveur.
//  - Aucun mot de passe ni secret ne doit figurer ici : l'application n'en a pas besoin.
//  Référence détaillée : docs/09-exploitation.md
// =====================================================================================================
{
  // Niveau de détail des journaux (Information, Warning, Error). Sous IIS / service, ils sont envoyés
  // dans l'Observateur d'événements Windows (journal « Application »).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Noms d'hôte acceptés. "*" = tous. Pour restreindre : "comptage.entreprise.local;SERVEUR".
  "AllowedHosts": "*",

  "Database": {
    // Fichier SQLite (relatif au dossier de l'application, ou chemin absolu). À inclure dans les sauvegardes.
    "Path": "App_Data/comptage.db"
  },

  "Directory": {
    // "ActiveDirectory" en production. ("Fake" = annuaire fictif réservé au développement.)
    "Provider": "ActiveDirectory",

    // Vide = tout le domaine du serveur. Pour limiter à une OU : "LDAP://OU=Personnel,DC=entreprise,DC=local"
    "SearchRoot": "",

    // Filtre appliqué à toutes les recherches : comptes utilisateurs ACTIFS (les comptes désactivés sont exclus).
    "BaseFilter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",

    // Nombre de caractères à saisir avant d'afficher les suggestions.
    "MinSearchLength": 4,

    // Nombre maximal de suggestions affichées.
    "MaxResults": 20,

    // Délai maximal d'une recherche dans l'annuaire (secondes).
    "TimeoutSeconds": 10
  },

  "Trash": {
    // Durée pendant laquelle un incident supprimé reste restaurable depuis la Corbeille (heures).
    "RetentionHours": 24,

    // Fréquence de la purge automatique des incidents expirés (minutes).
    "PurgeIntervalMinutes": 15
  },

  // Adresse d'écoute en mode AUTONOME (service Windows / exe). IGNORÉ sous IIS (ce sont les liaisons
  // du site IIS qui s'appliquent). Pour HTTPS, voir docs/08-installation-autonome.md.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}
