<!--
  Projet de l'application « Comptage incident » (ASP.NET Core 10, version LTS supportée jusqu’en novembre 2028).
  Dépendances (toutes publiées par Microsoft, versions figées pour des déploiements reproductibles) :
    - Microsoft.AspNetCore.Authentication.Negotiate : authentification Windows (Kerberos / NTLM).
    - Microsoft.Data.Sqlite                          : accès à la base SQLite locale (moteur SQLite inclus).
    - Microsoft.Extensions.Hosting.WindowsServices   : exécution en tant que service Windows (mode autonome).
    - System.DirectoryServices                       : recherche dans Active Directory (Windows uniquement).
  Voir docs/02-architecture.md.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Sécurité : la configuration de DÉVELOPPEMENT (utilisateur simulé, annuaire fictif) n'est jamais copiée
      dans le dossier publié. Même si ASPNETCORE_ENVIRONMENT valait « Development » par erreur sur un
      serveur, l'utilisateur simulé ne pourrait donc pas être activé.
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
