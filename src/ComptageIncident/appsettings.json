{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "App_Data/comptage.db"
  },

  "Directory": {
    "Provider": "ActiveDirectory",
    "SearchRoot": "",
    "BaseFilter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",
    "MinSearchLength": 4,
    "MaxResults": 20,
    "TimeoutSeconds": 10
  },

  "Trash": {
    "RetentionHours": 24,
    "PurgeIntervalMinutes": 15
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}
